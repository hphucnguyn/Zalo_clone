<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.zalo.client.ui.controller.MainController">
    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0" /></padding>
    <top>
        <VBox spacing="10.0">
            <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <HBox spacing="8.0">
                <TextField fx:id="recipientUsernameField" onAction="#openDirect" promptText="Username người muốn chat" HBox.hgrow="ALWAYS" />
                <Button fx:id="openDirectButton" mnemonicParsing="false" onAction="#openDirect" text="Mở chat 1-1" />
            </HBox>
            <Label fx:id="statusLabel" />
            <Label fx:id="conversationLabel" style="-fx-font-weight: bold;" text="Chưa chọn hội thoại" />
        </VBox>
    </top>
    <center>
        <ListView fx:id="messagesView">
            <BorderPane.margin><Insets bottom="12.0" top="20.0" /></BorderPane.margin>
        </ListView>
    </center>
    <bottom>
        <HBox spacing="8.0">
            <TextField fx:id="messageField" onAction="#sendMessage" promptText="Nhập tin nhắn" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#sendMessage" text="Gửi" />
        </HBox>
    </bottom>
</BorderPane>
