<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.zalo.client.ui.controller.RegisterController"
    prefWidth="960" prefHeight="640"
    style="-fx-background-color: #f0f4ff;">

    <HBox alignment="CENTER">

        <!-- ── Left Brand Banner ── -->
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: #0068ff; -fx-min-width: 420px; -fx-pref-width: 420px;">
            <StackPane>
                <Circle radius="52" fill="white" opacity="0.15"/>
                <Label text="Z" style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </StackPane>
            <Label text="Zalo Clone" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Tạo tài khoản mới để kết nối trò chuyện cùng bạn bè và đồng nghiệp"
                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.85); -fx-text-alignment: CENTER;"
                   wrapText="true" maxWidth="300"/>
            <Region prefHeight="16"/>
            <VBox spacing="14" alignment="CENTER_LEFT" maxWidth="280">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="✨" style="-fx-font-size: 16px;"/>
                    <Label text="Miễn phí &amp; bảo mật đầu cuối TLS" style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🚀" style="-fx-font-size: 16px;"/>
                    <Label text="Tốc độ gửi tin nhắn tức thì" style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👥" style="-fx-font-size: 16px;"/>
                    <Label text="Tạo nhóm trò chuyện không giới hạn" style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💾" style="-fx-font-size: 16px;"/>
                    <Label text="Đồng bộ &amp; lưu trữ offline an toàn" style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- ── Right Register Form ── -->
        <VBox alignment="CENTER_LEFT" spacing="0" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

            <Label text="Đăng ký tài khoản" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111;"/>
            <Region prefHeight="4"/>
            <Label text="Điền các thông tin bên dưới để bắt đầu sử dụng Zalo PC"
                   style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
            <Region prefHeight="24"/>

            <!-- Tên đăng nhập -->
            <Label text="Tên đăng nhập (Username)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <TextField fx:id="usernameField"
                       promptText="Ví dụ: user_a"
                       styleClass="text-field"
                       maxWidth="Infinity"/>
            <Region prefHeight="14"/>

            <!-- Tên hiển thị -->
            <Label text="Tên hiển thị (Họ và tên)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <TextField fx:id="displayNameField"
                       promptText="Ví dụ: Nguyễn Văn A"
                       styleClass="text-field"
                       maxWidth="Infinity"/>
            <Region prefHeight="14"/>

            <!-- Số điện thoại -->
            <Label text="Số điện thoại" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <TextField fx:id="phoneNumberField" promptText="Ví dụ: 0912345678"
                       styleClass="text-field" maxWidth="Infinity"/>
            <Region prefHeight="14"/>

            <!-- Mật khẩu -->
            <Label text="Mật khẩu" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <PasswordField fx:id="passwordField"
                           promptText="Tối thiểu 6 ký tự"
                           styleClass="text-field"
                           maxWidth="Infinity"/>
            <Region prefHeight="14"/>

            <!-- Xác nhận mật khẩu -->
            <Label text="Xác nhận mật khẩu" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Nhập lại mật khẩu"
                           styleClass="text-field"
                           maxWidth="Infinity"/>
            <Region prefHeight="16"/>

            <!-- Điều khoản -->
            <CheckBox fx:id="termsCheckBox"
                      text="Tôi đồng ý với Điều khoản dịch vụ và Chính sách bảo mật của Zalo"
                      selected="true"
                      style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
            <Region prefHeight="20"/>

            <!-- Nút đăng ký -->
            <Button fx:id="registerButton" text="Đăng ký tài khoản" onAction="#handleRegister"
                    maxWidth="Infinity"
                    styleClass="button-primary"/>
            <Region prefHeight="16"/>

            <!-- Link quay lại Đăng nhập -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Bạn đã có tài khoản?" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                <Hyperlink text="Đăng nhập ngay" onAction="#goToLogin"
                           style="-fx-font-size: 13px; -fx-text-fill: #0068ff; -fx-font-weight: bold;"/>
            </HBox>
            <Region prefHeight="12"/>

            <!-- Status message -->
            <Label fx:id="statusLabel"
                   style="-fx-text-fill: #3c4043; -fx-font-size: 12px;"
                   wrapText="true" maxWidth="Infinity" alignment="CENTER"/>
        </VBox>
    </HBox>
</StackPane>