<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.zalo.client.ui.controller.LoginController"
    prefWidth="960" prefHeight="600"
    style="-fx-background-color: #f0f4ff;">

    <!-- Split layout: left brand panel + right form -->
    <HBox alignment="CENTER">

        <!-- ── Left brand panel ── -->
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: #0068ff; -fx-min-width: 420px; -fx-pref-width: 420px;">
            <!-- Logo circle -->
            <StackPane>
                <Circle radius="52" fill="white" opacity="0.15"/>
                <Label text="Z" style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </StackPane>
            <Label text="Zalo Clone" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Nhắn tin, kết nối &amp; chia sẻ"
                   style="-fx-font-size: 15px; -fx-text-fill: rgba(255,255,255,0.80); -fx-text-alignment: CENTER;"
                   wrapText="true" maxWidth="280"/>
            <Region VBox.vgrow="NEVER" prefHeight="20"/>
            <!-- Feature list -->
            <VBox spacing="12" alignment="CENTER_LEFT" maxWidth="260">
                <Label text="🔒  Kết nối TLS an toàn"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.90);"/>
                <Label text="💬  Nhắn tin 1-1 &amp; nhóm"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.90);"/>
                <Label text="📋  Lịch sử offline tự động"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.90);"/>
                <Label text="✅  Trạng thái Đã xem / Đã nhận"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.90);"/>
            </VBox>
        </VBox>

        <!-- ── Right form panel ── -->
        <VBox alignment="CENTER_LEFT" spacing="0" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="60" right="64" bottom="60" left="64"/></padding>

            <!-- Header -->
            <Label text="Đăng nhập" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111;"/>
            <Region prefHeight="4"/>
            <Label text="Chào mừng bạn quay trở lại với Zalo Desktop 👋"
                   style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
            <Region prefHeight="36"/>

            <!-- Username -->
            <Label text="Tên đăng nhập" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <TextField fx:id="usernameField"
                       promptText="Ví dụ: linh_nguyen"
                       styleClass="text-field"
                       maxWidth="Infinity"/>
            <Region prefHeight="20"/>

            <!-- Password -->
            <Label text="Mật khẩu" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
            <Region prefHeight="6"/>
            <PasswordField fx:id="passwordField"
                           promptText="Mật khẩu của bạn"
                           styleClass="text-field"
                           maxWidth="Infinity"/>
            <Region prefHeight="28"/>

            <!-- Login button -->
            <Button fx:id="loginButton" text="Đăng nhập" onAction="#login"
                    maxWidth="Infinity"
                    styleClass="button-primary"/>
            <Region prefHeight="16"/>

            <!-- Register switcher -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Chưa có tài khoản?" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                <Hyperlink text="Đăng ký tài khoản mới" onAction="#goToRegister"
                           style="-fx-font-size: 13px; -fx-text-fill: #0068ff; -fx-font-weight: bold;"/>
            </HBox>
            <Region prefHeight="20"/>

            <!-- Status label -->
            <Label fx:id="statusLabel"
                   style="-fx-text-fill: #3c4043; -fx-font-size: 12px;"
                   wrapText="true" maxWidth="Infinity" alignment="CENTER"/>
        </VBox>
    </HBox>
</StackPane>
